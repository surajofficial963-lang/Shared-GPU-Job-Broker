  "templating": {
    "list": [
      {
        "name": "team",
        "label": "Team",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "broker-prometheus"
        },
        "query": "label_values(broker_job_queue_wait_seconds_count, team)",
        "definition": "label_values(broker_job_queue_wait_seconds_count, team)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "gpu_type",
        "label": "GPU node type",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "broker-prometheus"
        },
        "query": "label_values(broker_job_queue_wait_seconds_count{team=~\"$team\"}, gpu_type)",
        "definition": "label_values(broker_job_queue_wait_seconds_count{team=~\"$team\"}, gpu_type)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "percentile",
        "label": "Percentile",
        "type": "custom",
        "query": "p50 : 0.50, p75 : 0.75, p90 : 0.90, p95 : 0.95, p99 : 0.99",
        "current": {
          "text": "p90",
          "value": "0.90",
          "selected": true
        },
        "options": [
          {
            "text": "p50",
            "value": "0.50",
            "selected": false
          },
          {
            "text": "p75",
            "value": "0.75",
            "selected": false
          },
          {
            "text": "p90",
            "value": "0.90",
            "selected": true
          },
          {
            "text": "p95",
            "value": "0.95",
            "selected": false
          },
          {
            "text": "p99",
            "value": "0.99",
            "selected": false
          }
        ],
        "multi": false,
        "includeAll": false
      }
    ]
  },
