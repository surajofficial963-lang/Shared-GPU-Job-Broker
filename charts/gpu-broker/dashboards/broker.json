{
  "title": "Shared GPU Job Broker",
  "uid": "shared-gpu-broker",
  "schemaVersion": 39,
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 11,
      "type": "timeseries",
      "title": "Job completion time p90",
      "datasource": {
        "type": "prometheus",
        "uid": "broker-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "broker-prometheus"
          },
          "legendFormat": "p90 {{team}} / {{gpu_type}}",
          "expr": "histogram_quantile(0.90, sum by (le, team, gpu_type) (broker_job_runtime_seconds_bucket{team=~\"$team\",gpu_type=~\"$gpu_type\"}))"
        }
      ],
      "description": "Approximate cumulative percentiles from job start to successful completion."
    },
    {
      "id": 13,
